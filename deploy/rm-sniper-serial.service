[Unit]
Description=RoboMaster Sniper - Serial bridge (ROS /video_stream → 下位机)
After=rm-sniper-ros.service local-fs.target
Wants=rm-sniper-ros.service local-fs.target
Requires=rm-sniper-ros.service

[Service]
Type=simple
User=rmnuc1
WorkingDirectory=/home/rmnuc1/RM-customization

Environment="HOME=/home/rmnuc1"

# 等待 ROS pipeline 就绪
ExecStartPre=/bin/bash -c '\
  source /opt/ros/humble/setup.bash && \
  source /home/rmnuc1/RM-customization/install/setup.bash && \
  for i in $(seq 1 30); do \
    ros2 topic list 2>/dev/null | grep -q /video_stream && break; \
    echo "Waiting for /video_stream... ($i/30)"; \
    sleep 2; \
  done'

ExecStart=/bin/bash -c '\
  source /opt/ros/humble/setup.bash && \
  source /home/rmnuc1/RM-customization/install/setup.bash && \
  exec python3 /home/rmnuc1/RM-customization/tools/serial_bridge.py \
    --device /dev/ttyACM0 --baud 921600 --robot-id 1 \
    --no-keyframe-filter \
    --send-rate 45 --redundancy 1 \
    --print-stats'

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
